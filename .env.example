# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.

# Required for voice transcription (voice_input.py) and intent parsing
# (intent_parser.py, jarvis_actions.py ask_ai/solve_from_screenshot).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional -- only needed if you use play_spotify_search / play_spotify_playlist.
# Create an app at https://developer.spotify.com/dashboard
# Set its redirect URI to exactly: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional -- token required to use the phone remote (phone_server.py).
# If left empty, a random token is generated each run and printed to the
# console/log on startup -- set a fixed value here if you want a stable
# link instead of a new one every time you start Jarvis.
JARVIS_PHONE_TOKEN=
